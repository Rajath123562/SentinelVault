# HOTFIX Phase 1 Environment Configuration Template
# Copy this file to .env for local overrides (never commit secrets to version control)

HOTFIX_ENV=development
HOTFIX_BACKEND_HOST=127.0.0.1
HOTFIX_BACKEND_PORT=8000
HOTFIX_CORS_ORIGIN=http://localhost:5173
HOTFIX_LOG_LEVEL=INFO

# Relative configuration file paths
HOTFIX_CONFIG_PATH=config/app.yaml
HOTFIX_SPEC_PATH=config/spec.yaml

# Database configuration placeholder for future phases (Phase 1 does not access persistent store)
HOTFIX_DB_URL=sqlite:///./hotfix_dev.db

